{
  "functions": {
    "api/auth/login.js": {
      "maxDuration": 10
    },
    "api/admin/*.js": {
      "maxDuration": 30
    }
  },
  "env": {
    "ADMIN_USERNAME": "@ADMIN_USERNAME",
    "ADMIN_PASSWORD_HASH": "@ADMIN_PASSWORD_HASH",
    "JWT_SECRET": "@JWT_SECRET",
    "ALLOWED_IPS": "@ALLOWED_IPS"
  }
}
