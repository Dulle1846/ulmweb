{
  "functions": {
    "api/auth/login.js": {
      "maxDuration": 10
    },
    "api/admin/*.js": {
      "maxDuration": 30
    }
  },
  "env": {
    "ADMIN_USERNAME": "@ADMIN_USERNAME",          // Hier geändert!
    "ADMIN_PASSWORD_HASH": "@ADMIN_PASSWORD_HASH", // Hier geändert!
    "JWT_SECRET": "@JWT_SECRET",                   // Hier geändert!
    "ALLOWED_IPS": "@ALLOWED_IPS"                 // Hier geändert!
  }
}
