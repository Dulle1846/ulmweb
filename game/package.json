{
  "name": "kings-and-cards",
  "version": "3.14.2",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test && node scripts/check-syntax.js",
    "build:runtime": "node scripts/build-runtime.mjs",
    "test:e2e:setup": "node tests/browser/setup-e2e.mjs",
    "test:e2e": "node tests/browser/run-e2e.mjs",
    "test:terrain-reference": "node tests/browser/terrain-reference.mjs",
    "test:season-year": "node tests/browser/season-year.mjs",
    "test:climate-reference": "node tests/browser/climate-reference.mjs",
    "test:desert-reference": "node tests/browser/desert-reference.mjs",
    "test:tundra-reference": "node tests/browser/tundra-reference.mjs",
    "test:savanna-reference": "node tests/browser/savanna-reference.mjs",
    "test:forest-reference": "node tests/browser/forest-reference.mjs",
    "test:conifer-reference": "node tests/browser/conifer-reference.mjs",
    "test:mixed-reference": "FOREST_REFERENCE_PROFILE=mixed node tests/browser/forest-reference.mjs",
    "test:tropical-reference": "FOREST_REFERENCE_PROFILE=tropical node tests/browser/forest-reference.mjs",
    "test:jungle-proof": "node tests/browser/jungle-proof.mjs && node scripts/sync-jungle-doc.mjs",
    "test:jungle-raid": "node tests/browser/jungle-raid.mjs",
    "test:forest-occlusion": "node tests/browser/forest-occlusion.mjs",
    "test:forest-detail": "node tests/browser/forest-detail-reference.mjs",
    "test:terrain-stability": "node tests/browser/terrain-stability.mjs",
    "test:renderer-recycle": "node tests/browser/renderer-recycle-audit.mjs",
    "test:device-benchmark": "node tests/browser/device-benchmark.mjs",
    "test:performance:low-end": "node tests/browser/low-end-performance.mjs",
    "test:atmosphere-reference": "node tests/browser/daylight-reference.mjs",
    "test:forester-stewardship": "node tests/browser/forester-stewardship.mjs",
    "test:forester-stewardship-longrun": "node tests/browser/forester-stewardship-longrun.mjs",
    "test:forest-stewardship-ui": "node tests/browser/forest-stewardship-ui.mjs",
    "test:playability": "node tests/browser/playability-audit.mjs",
    "test:core-loop": "node tests/browser/core-loop-audit.mjs",
    "test:chronicles": "node tests/browser/chronicle-audit.mjs",
    "test:campaign": "node scripts/long-campaign.mjs",
    "test:campaign:players": "node scripts/player-profiles.mjs",
    "test:colossal-growth": "node --expose-gc scripts/colossal-decade-growth.mjs",
    "test:campaign:browser": "node tests/browser/long-campaign.mjs",
    "test:jungle-understory": "JUNGLE_PROOF_ZOOM=2.4 JUNGLE_PROOF_OUT=artifacts/jungle-understory-2.4 node tests/browser/jungle-proof.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
