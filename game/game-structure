│   │   ├── morale.js                  # Moralregeln
│   │   ├── tech.js                    # Forschung und Technologieeffekte
│   │   ├── cards.js                   # Kartendeck und Platzierungsregeln
│   │   └── events.js                  # Zufallsereignisse
│   ├── simulation/
│   │   ├── simulation.js              # Autoritativer logischer Simulationstick
│   │   ├── villagers.js               # Dorfbewohnerverhalten und Bewegung
│   │   ├── combat.js                  # Kampf und Raids
│   │   └── buildings.js               # Gebäudeproduktion und Effekte
