```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fantasy Tavern</title>
    <link rel="stylesheet" href="fantasy-tavern.css">
</head>
<body>
    <div id="tavern">
        <h1>Welcome to the Mystic Moon Tavern!</h1>
        <div class="tavern-exterior">
            <img src="tavern-exterior.png" alt="Tavern Exterior" class="tavern-picture">
            <div class="exterior-overlay"></div>
        </div>
        <div class="tavern-interior">
            <img src="tavern-interior.png" alt="Tavern Interior" class="tavern-picture">
            <div class="interior-overlay"></div>
            <div class="interior-content">
                <p>Step inside the warm and cozy Mystic Moon Tavern, where travelers from all walks of life gather to share tales of their adventures and enjoy a pint of our finest ale.</p>
                <button onclick="toggleExterior()">Enter Tavern</button>
            </div>
        </div>
    </div>
    <script>
        function toggleExterior() {
            const tavern = document.getElementById('tavern');
            const exterior = tavern.querySelector('.tavern-exterior');
            const interior = tavern.querySelector('.tavern-interior');

            if (exterior.style.display === 'none') {
                interior.style.display = 'none';
                exterior.style.display = 'block';
            } else {
                exterior.style.display = 'none';
                interior.style.display = 'block';
            }
        }
    </script>
</body>
</html>
```

